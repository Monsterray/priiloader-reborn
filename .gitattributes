# Line endings: text is LF in the repository and in every checkout, on every
# platform, whatever core.autocrlf says (Git for Windows sets it to true).
* text=auto eol=lf

# Windows batch files: LF in the repository like everything else, CRLF in
# the checkout, because cmd.exe misreads labels and GOTO in LF batch files.
*.bat text eol=crlf

